@model Student.Models.StudentModel

<h2 class="text-primary">Trang Đăng Ký Chuyên Ngành</h2>
<form asp-action="ShowKQ" method="post" class="p-3 border">
    <div class="mb-3">
        <label>MSSV:</label>
        <input asp-for="MSSV" class="form-control" required />
    </div>
    <div class="mb-3">
        <label>Họ tên:</label>
        <input asp-for="HoTen" class="form-control" required />
    </div>
    <div class="mb-3">
        <label>Điểm TB:</label>
        <input asp-for="DiemTB" type="number" step="0.1" class="form-control" required />
    </div>
    <div class="mb-3">
        <label>Chuyên ngành:</label>
        <select asp-for="ChuyenNganh" class="form-control">
            <option value="CNPM">Công nghệ phần mềm</option>
            <option value="HTTT">Hệ thống thông tin</option>
            <option value="ANM">An ninh mạng</option>
            <option value="TTNT">Trí tuệ nhân tạo</option>
            <option value="MMT">Mạng máy tính</option>
        </select>
    </div>
    <button type="submit" class="btn btn-success">Đăng ký</button>
</form>